{
  "name": "ai-dev-companion-frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.cjs\" App.tsx index.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.cjs\" App.tsx index.ts",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "expo": "~58.0.23",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-hook-form": "^7.81.0",
    "react-native": "0.88.1",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
